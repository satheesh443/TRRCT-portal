{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/student-portal",
      "dest": "/frontend/student-portal.html"
    },
    {
      "src": "/staff-portal",
      "dest": "/frontend/staff-portal.html"
    },
    {
      "src": "/admin-portal",
      "dest": "/frontend/admin-portal.html"
    },
    {
      "src": "/library",
      "dest": "/frontend/library.html"
    },
    {
      "src": "/public/(.*)",
      "dest": "/frontend/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
